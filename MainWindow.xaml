<Window
    x:Class="ZenFiles.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:ZenFiles.Models">

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidepanel (gjennomsiktig Mica, Finder-stil) -->
        <Grid Grid.Column="0" Padding="10,0,8,8">
            <Grid.Resources>
                <Style x:Key="SectionHeader" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Margin" Value="10,16,0,4"/>
                </Style>

                <DataTemplate x:Key="EntryTemplate" x:DataType="m:SidebarEntry">
                    <Grid ColumnSpacing="10" MinHeight="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="#FF3D9BFF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Sub}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind SubVisibility}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- Myk grå markering som i Finder -->
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2A808080"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33808080"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3A808080"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#18808080"/>
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ZenFiles" FontWeight="SemiBold" FontSize="13" Opacity="0.7"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Favoritter" Style="{StaticResource SectionHeader}" Margin="10,2,0,4"/>
                    <ListView x:Name="QuickList" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemTemplate="{StaticResource EntryTemplate}" ItemClick="Quick_ItemClick"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              DragOver="Quick_DragOver" Drop="Quick_Drop" RightTapped="Quick_RightTapped"
                              ContainerContentChanging="Side_ContainerContentChanging"/>

                    <TextBlock Text="Steder" Style="{StaticResource SectionHeader}"/>
                    <ListView x:Name="DriveList" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemTemplate="{StaticResource EntryTemplate}" ItemClick="Quick_ItemClick"
                              ContainerContentChanging="Side_ContainerContentChanging"/>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="SSH / SFTP" Style="{StaticResource SectionHeader}" Margin="10,4,0,4"/>
                        <Button HorizontalAlignment="Right" Padding="6,2" Background="Transparent" BorderThickness="0"
                                Click="AddSsh_Click" ToolTipService.ToolTip="Ny SSH-tilkobling">
                            <SymbolIcon Symbol="Add"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="SshList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemTemplate="{StaticResource EntryTemplate}" ItemClick="Ssh_ItemClick" RightTapped="Ssh_RightTapped"
                              ContainerContentChanging="Side_ContainerContentChanging"/>
                    <TextBlock x:Name="SshEmpty" Text="Ingen tilkoblinger ennå. Trykk + for å legge til en server."
                               FontSize="12" Opacity="0.5" TextWrapping="Wrap" Margin="10,2,8,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="2,6,0,0">
                <Button Click="NewTerminal_Click" Background="Transparent" BorderThickness="0" Padding="9,7"
                        ToolTipService.ToolTip="Ny terminal (Ctrl+Shift+T)">
                    <FontIcon Glyph="&#xE756;" FontSize="15"/>
                </Button>
                <Button x:Name="SettingsBtn" Background="Transparent" BorderThickness="0" Padding="9,7"
                        ToolTipService.ToolTip="Innstillinger">
                    <FontIcon Glyph="&#xE713;" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Faner -->
        <TabView x:Name="Tabs" Grid.Column="1" Background="Transparent"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 AddTabButtonClick="Tabs_AddClick" TabCloseRequested="Tabs_CloseRequested"
                 SelectionChanged="Tabs_SelectionChanged"
                 CanReorderTabs="True" CanDragTabs="True">
            <TabView.TabStripFooter>
                <Grid x:Name="DragArea" MinWidth="140" Background="Transparent"/>
            </TabView.TabStripFooter>
        </TabView>
    </Grid>
</Window>
