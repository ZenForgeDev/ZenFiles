<UserControl
    x:Class="ZenFiles.Views.ExplorerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:ZenFiles.Models"
    xmlns:v="using:ZenFiles.Views">

    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <DataTemplate x:Key="DetailsTemplate" x:DataType="m:FileItem">
            <Grid MinHeight="30" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <v:ItemIcon Item="{x:Bind}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,2">
                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <!-- Mappen treffet ligger i (bare i søkeresultater) -->
                    <TextBlock Text="{x:Bind Where}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind WhereVisibility}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
                <TextBlock Grid.Column="4" Text="{x:Bind TypeText}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GridTemplate" x:DataType="m:FileItem">
            <!-- Fast høyde: GridView bruker størrelsen til første element som cellestørrelse, så en rute med kort navn først
                 klippet bort andre linje på lange navn. Høyden rommer ikon pluss to tekstlinjer. -->
            <StackPanel Width="108" Height="124" Padding="4,10,4,6" Spacing="6"
                        ToolTipService.ToolTip="{x:Bind TipText}">
                <v:ItemIcon Item="{x:Bind}" Width="64" Height="64" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" FontSize="12"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Layout" Background="{StaticResource ZenPanelBrush}" CornerRadius="8,0,0,0"
          AllowDrop="True" DragOver="Pane_DragOver" Drop="Pane_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Verktøylinje (Finder-stil) -->
        <Grid Grid.Row="0" Padding="10,8,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackBtn" Style="{StaticResource ToolBtn}" Click="Back_Click" ToolTipService.ToolTip="Tilbake">
                    <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                </Button>
                <Button x:Name="FwdBtn" Style="{StaticResource ToolBtn}" Click="Forward_Click" ToolTipService.ToolTip="Fremover">
                    <FontIcon Glyph="&#xE76C;" FontSize="13"/>
                </Button>
                <Button x:Name="UpBtn" Style="{StaticResource ToolBtn}" Click="Up_Click" ToolTipService.ToolTip="Opp ett nivå">
                    <FontIcon Glyph="&#xE74A;" FontSize="13"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>

            <Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="ListToggle" Style="{StaticResource ToolToggle}" IsChecked="True" Click="ListToggle_Click" ToolTipService.ToolTip="Som liste">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolToggle}" Click="GridToggle_Click" ToolTipService.ToolTip="Som ikoner">
                        <FontIcon Glyph="&#xE80A;" FontSize="14"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
                <Button Style="{StaticResource ToolBtn}" Click="NewFolder_Click" ToolTipService.ToolTip="Ny mappe">
                    <FontIcon Glyph="&#xE8F4;" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="Delete_Click" ToolTipService.ToolTip="Slett">
                    <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="Terminal_Click" ToolTipService.ToolTip="Åpne terminal her">
                    <FontIcon Glyph="&#xE756;" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource ToolBtn}" ToolTipService.ToolTip="Mer">
                    <FontIcon Glyph="&#xE712;" FontSize="15"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Kopier til andre rute" Click="Copy_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Flytt til andre rute" Click="Move_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="MoveToFolder"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Gi nytt navn" Click="Rename_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Rename"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Dobbel rute" Click="Dual_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Vis skjulte filer" Click="HiddenToggle_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Grid Grid.Column="4" Width="210">
                <TextBox x:Name="SearchBox" PlaceholderText="Søk · Enter for dypt søk" Padding="30,6,8,6" CornerRadius="8"
                         TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"
                         ToolTipService.ToolTip="Skriv for å filtrere denne mappen. Enter søker i alle undermapper, Ctrl+Enter på alle stasjoner. Esc avslutter."/>
                <FontIcon Glyph="&#xE721;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                          IsHitTestVisible="False" Opacity="0.55"/>
            </Grid>
        </Grid>

        <!-- Innhold -->
        <Grid x:Name="ListArea" Grid.Row="1" Margin="6,0,6,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Tom stripe til høyre: her kan man starte en markeringsboks med musa -->
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="HeaderRow" Padding="12,0,12,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NameHdr" Grid.Column="1" Content="Navn" Tag="name" Click="Sort_Click" Style="{StaticResource HeaderBtn}"/>
                    <Button x:Name="DateHdr" Grid.Column="2" Content="Endret" Tag="date" Click="Sort_Click" Style="{StaticResource HeaderBtn}"/>
                    <Button x:Name="SizeHdr" Grid.Column="3" Content="Størrelse" Tag="size" Click="Sort_Click" Style="{StaticResource HeaderBtn}"/>
                    <Button x:Name="TypeHdr" Grid.Column="4" Content="Type" Tag="type" Click="Sort_Click" Style="{StaticResource HeaderBtn}"/>
                </Grid>
            </Border>

            <ListView x:Name="DetailsList" Grid.Row="1" ItemTemplate="{StaticResource DetailsTemplate}"
                      SelectionMode="Extended" CanDragItems="True" Padding="0,4,0,4"
                      ContainerContentChanging="Row_ContainerContentChanging"
                      DoubleTapped="List_DoubleTapped" RightTapped="List_RightTapped" KeyDown="List_KeyDown"
                      DragItemsStarting="List_DragStarting" DragItemsCompleted="List_DragCompleted" SelectionChanged="List_SelectionChanged">
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ZenSelectBrush"/>
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ZenSelectHoverBrush"/>
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ZenSelectPressedBrush"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White"/>
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
                </ListView.Resources>
            </ListView>

            <GridView x:Name="GridList" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                      ItemTemplate="{StaticResource GridTemplate}" Padding="6"
                      SelectionMode="Extended" CanDragItems="True" ContainerContentChanging="Grid_ContainerContentChanging"
                      DoubleTapped="List_DoubleTapped" RightTapped="List_RightTapped" KeyDown="List_KeyDown"
                      DragItemsStarting="List_DragStarting" DragItemsCompleted="List_DragCompleted" SelectionChanged="List_SelectionChanged">
                <GridView.Resources>
                    <StaticResource x:Key="GridViewItemBackgroundSelected" ResourceKey="ZenSelectSoftBrush"/>
                    <StaticResource x:Key="GridViewItemBackgroundSelectedPointerOver" ResourceKey="ZenSelectSoftHoverBrush"/>
                    <SolidColorBrush x:Key="GridViewItemSelectionIndicatorBrush" Color="Transparent"/>
                </GridView.Resources>
            </GridView>

            <Canvas Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" Fill="{StaticResource ZenSelectSoftBrush}" Stroke="{StaticResource ZenSelectBrush}"
                           StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            </Canvas>
        </Grid>

        <!-- Status (midtstilt) -->
        <Grid Grid.Row="2" Padding="14,6,14,2">
            <Button x:Name="CloseSearchBtn" Visibility="Collapsed" HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                    Click="CloseSearch_Click" ToolTipService.ToolTip="Tilbake til mappen (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    <TextBlock Text="Lukk søk"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="Status" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="90,0,0,0"/>
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="14" Height="14"/>
                <TextBlock x:Name="BusyText" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Stibar (brødsmulesti) -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="PathBar" Padding="10,4,10,4" MinHeight="34" Background="Transparent" DoubleTapped="PathBar_DoubleTapped" Tapped="PathBar_Tapped">
                <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>
                <Button x:Name="EditPathBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,3"
                        Background="Transparent" BorderThickness="0" Click="EditPath_Click"
                        ToolTipService.ToolTip="Skriv inn sti (Ctrl+L)">
                    <FontIcon Glyph="&#xE70F;" FontSize="12" Opacity="0.7"/>
                </Button>
                <TextBox x:Name="PathBox" Visibility="Collapsed" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus"
                         VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
